# =====================================================================
# Q-SHIELD STREAMLIT COMMUNITY CLOUD SECRETS TEMPLATE
# For Streamlit Community Cloud: paste into "App Settings > Secrets"
# For local testing: copy to .streamlit/secrets.toml (ignored by git)
# =====================================================================

QSHIELD_DASHBOARD_USERNAME = "analyst"

# Plaintext password for development / simple cloud testing:
QSHIELD_DASHBOARD_PASSWORD = "replace-with-your-own-strong-password"

# Or use a hardened scrypt hash (takes priority over plaintext password):
# Generate with: python -m scripts.generate_password_hash
# QSHIELD_DASHBOARD_PASSWORD_HASH = "scrypt$16384$8$1$..."

# Remote Q-SHIELD TCP Server host/port (if connecting to an external cloud backend):
QSHIELD_SERVER_HOST = "127.0.0.1"
QSHIELD_SERVER_PORT = "5001"
QSHIELD_DATA_DIR = "data"

