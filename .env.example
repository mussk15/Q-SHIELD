# =====================================================================
# Q-SHIELD ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure secrets before deployment.
# NEVER commit production .env files to Git.
# =====================================================================

# --------------------------------------------------
# DASHBOARD AUTHENTICATION & ACCESS
# --------------------------------------------------
QSHIELD_DASHBOARD_USERNAME=analyst

# For local development: plaintext password (not recommended for public cloud)
QSHIELD_DASHBOARD_PASSWORD=replace-with-your-own-strong-password

# For hardened cloud deployment: salted scrypt password hash
# Generate via: python -m scripts.generate_password_hash
# If set, QSHIELD_DASHBOARD_PASSWORD_HASH takes precedence over plaintext password.
QSHIELD_DASHBOARD_PASSWORD_HASH=

# --------------------------------------------------
# NETWORKING & CLOUD SERVER CONFIGURATION
# --------------------------------------------------
# Local: 127.0.0.1; Cloud VPS/Docker: 0.0.0.0
QSHIELD_SERVER_HOST=127.0.0.1
QSHIELD_SERVER_PORT=5001

# Keystore unlock passwords
QSHIELD_SERVER_PASSWORD=QSHIELD
QSHIELD_CLIENT_PASSWORD=QSHIELD

# --------------------------------------------------
# PERSISTENT STORAGE
# --------------------------------------------------
QSHIELD_DATA_DIR=data

# --------------------------------------------------
# CLOUD REVERSE PROXY & HTTPS (Caddy / Let's Encrypt)
# --------------------------------------------------
# Domain or IP pointing to your cloud server (e.g. qshield.yourdomain.com)
QSHIELD_DOMAIN=localhost
ACME_EMAIL=admin@example.com
